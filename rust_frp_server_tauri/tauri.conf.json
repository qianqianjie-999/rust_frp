{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust_frps-gui",
  "version": "0.2.2",
  "identifier": "com.rustfrp.server",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rust_frp 服务端",
        "width": 700,
        "height": 640,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
